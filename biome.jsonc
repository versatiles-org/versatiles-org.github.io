{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// TypeScript sources, the repo's own JSON config, and the page templates.
		// Biome 2.5 has no Markdown or HTML *formatter*, so the HTML entries here
		// only feed its a11y linter.
		"includes": [
			"src/**/*.ts",
			"*.ts",
			"*.json",
			"*.jsonc",
			"docs/**/*.html",
			"templates/**/*.html",
			"!package-lock.json",
			// The CMS lets a page carry YAML front matter, which Biome accepts only
			// inside Astro files and otherwise rejects as a parse error. This is the
			// one HTML page using it, so it cannot be linted.
			"!docs/index.html"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			// menu.less sets `list-style: none` on the nav <ul>, and Safari/VoiceOver
			// then stop announcing it as a list — the explicit role="list" restores
			// that, so it is not really redundant. Suppressed here rather than with an
			// inline biome-ignore comment, which would ship into every built page.
			"includes": ["templates/page.html"],
			"linter": { "rules": { "a11y": { "noRedundantRoles": "off" } } }
		}
	],
	"assist": {
		"actions": {
			"source": {
				// Deno never sorted imports and the migration is not the place to
				// start; flip to "on" separately if you want it enforced.
				"organizeImports": "off"
			}
		}
	}
}

{
  "tasks": {
    "check": "deno lint && deno fmt && deno test -A",
    "coverage": "rm -rf coverage && deno test -A --coverage=coverage --coverage-raw-data-only && deno coverage coverage --exclude='dynamic_test' && deno coverage coverage --exclude='dynamic_test' --lcov --output=coverage/lcov.info",
    "build": "deno run -A src/build.ts",
    "dev": "deno run --watch='src,docs' --watch-exclude='**/.DS_Store' -A src/dev.ts",
    "sponsors:fixture": "deno run -A src/sponsors/fixture.ts",
    "test": "deno test -A",
    "upgrade": "deno outdated --update --latest"
  },
  "nodeModulesDir": "none",
  // TRANSITIONAL — removed together with this file at the end of the Node
  // migration. Deno auto-discovers the root package.json and applies its
  // minimum-dependency-age policy to every entry, including devDependencies it
  // never imports, so any freshly published tool blocks the build. Deno 2.9
  // also reads tsconfig.json, whose Node-oriented "lib" hides the Deno globals
  // — so run `deno test -A --no-check` until the migration lands.
  "minimumDependencyAge": 0,
  "imports": {
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "cheerio_cms": "npm:cheerio_cms@^1.1.0",
    "clean-css": "npm:clean-css@^5.3.3",
    "less": "npm:less@^4.8.1"
  },
  "fmt": {
    "useTabs": true,
    "lineWidth": 100,
    "indentWidth": 3,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": [
      "docs/",
      "playground/",
      "src/"
    ],
    "exclude": [
      "**/*.yaml",
      "**/*.yml",
      "**/*.svg",
      "docs/index.html"
    ]
  }
}

# @deno/gfm, @std/front-matter and @std/yaml are published on JSR, which serves
# npm-compatible tarballs from npm.jsr.io.
@jsr:registry=https://npm.jsr.io

# npm 12 refuses tarballs served from outside the configured registry
# (EALLOWREMOTE), which is exactly how JSR delivers the packages above. "root"
# is the narrowest setting that still works — verified against a clean cache,
# including the transitive @jsr/denosaurs__emoji. Older npm ignores this key.
allow-remote=root

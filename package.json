{
	"name": "versatiles.org",
	"version": "1.0.0",
	"private": true,
	"description": "Static site generator for versatiles.org",
	"license": "Unlicense",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node src/build.ts",
		"dev": "vite",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome ci",
		"format": "biome check --write",
		"check": "biome check --write && tsc --noEmit && vitest run",
		"sponsors:fixture": "node src/sponsors/fixture.ts",
		"upgrade": "npx npm-check-updates -u && npm install"
	},
	"dependencies": {
		"@deno/gfm": "npm:@jsr/deno__gfm@^0.12.0",
		"@std/front-matter": "npm:@jsr/std__front-matter@^1.0.9",
		"@std/yaml": "npm:@jsr/std__yaml@^1.2.0",
		"cheerio_cms": "^1.1.0",
		"clean-css": "^5.3.3",
		"less": "^4.8.1",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/clean-css": "^4.2.11",
		"@types/less": "^3.0.8",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"sponsorkit": "^18.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}

{
	"name": "versatiles.org",
	"version": "1.0.0",
	"private": true,
	"description": "Static site generator for versatiles.org",
	"license": "Unlicense",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node src/build.ts",
		"check": "npm run lint && npm run typecheck && npm run test",
		"coverage": "vitest run --coverage",
		"dev": "vite",
		"format": "biome check --write",
		"lint": "biome ci",
		"sponsors:fixture": "node src/sponsors/fixture.ts",
		"test:watch": "vitest",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"upgrade": "npx npm-check-updates -u --peer && npm i && biome migrate --write && npm audit fix"
	},
	"dependencies": {
		"@versatiles/release-tool": "^2.20.0",
		"cheerio_cms": "^1.1.0",
		"clean-css": "^5.3.3",
		"he": "^2.0.0",
		"less": "^4.9.1",
		"marked": "^18.1.2",
		"marked-alert": "^2.1.2",
		"marked-footnote": "^1.4.0",
		"prismjs": "^1.30.0",
		"sharp": "^0.35.5",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/clean-css": "^4.2.11",
		"@types/he": "^1.2.3",
		"@types/less": "^3.0.8",
		"@types/node": "^26.6.6",
		"@types/prismjs": "^1.26.6",
		"@vitest/coverage-v8": "^5.0.5",
		"sponsorkit": "^19.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"fsevents": true
	}
}
